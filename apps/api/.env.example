# apps/api — copy to .env and adjust. Every variable is validated at startup;
# an invalid value makes the process exit non-zero rather than fall back to a
# default (see src/config.ts).

# development | test | production. Unset means development, never production.
NODE_ENV=development

# Bind address. Defaults to loopback: apps/web reaches the API through its
# own rewrite (ADR 0003 §6), and the production reverse proxy terminates
# HTTPS in front of it. Do not widen this without a proxy in front.
AI_KM_API_HOST=127.0.0.1
AI_KM_API_PORT=4000

# SQLite file (E04-S040 owns the schema). data/ is gitignored.
AI_KM_DB_PATH=./data/ai-km.sqlite

# Comma-separated allowlist. EMPTY (the default) disables CORS entirely.
# Only needed for the cross-origin escape hatch in ADR 0003 §6.
AI_KM_CORS_ORIGINS=

# Dev-only trigger accounts/strings (ADR 0005 §4). MUST be false in
# production — the server refuses to start otherwise.
AI_KM_DEV_TRIGGERS=false

# Per-login isolated data sandbox for E2E (ADR 0005 §5). MUST be false in
# production — the server refuses to start otherwise.
AI_KM_TEST_SANDBOX=false

# Seeds the 10 demo accounts (services/identity, E02-S032/S033) when `users`
# is empty. Defaults to true in development/test, false in production (the
# demo password is public). MUST be false in production — the server
# refuses to start otherwise.
AI_KM_SEED_DEMO_USERS=true

# Optional Set-Cookie `Domain` attribute for the session cookie
# (services/identity, E02-S033). Unset (the default) is a host-only cookie —
# fine when apps/web and apps/admin are deployed on the same host under
# different paths. No production restriction (not a security bypass flag).
AI_KM_SESSION_COOKIE_DOMAIN=

# Login throttle thresholds (services/identity, E02-S034). Comma-separated
# key:value pairs; unset keys keep the default. Defaults: 5 failures per
# username / 20 failures per IP within a 15-minute window locks that
# username/IP out (existing password stops working, no distinguishable
# response — see docs/adr, ADR 0005 and archive/stories/E02-S034.md).
# Example: AI_KM_LOGIN_RATE_LIMIT=perUsernameMaxFailures:5,perIpMaxFailures:20,windowMinutes:15
AI_KM_LOGIN_RATE_LIMIT=

# whisper-server | fake. `fake` is for unit/E2E only (ADR 0004 §2). MUST
# NOT be "fake" in production — services/model-gateway refuses to start
# otherwise. AI_KM_ASR_SERVER_URL must be a loopback/private-network host
# (SSRF guard, E12-S031) — a public host is refused at startup too.
AI_KM_ASR_PROVIDER=whisper-server
AI_KM_ASR_SERVER_URL=http://127.0.0.1:8178

# Text FakeTranscriptionProvider returns (unit/E2E only). Optional —
# defaults to "（測試）這是語音辨識的假結果 fake result" when unset.
# AI_KM_ASR_FAKE_TEXT=

# fatal | error | warn | info | debug | trace | silent
AI_KM_LOG_LEVEL=info
