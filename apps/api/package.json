{
  "name": "@ai-km/api",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "main": "./dist/main.js",
  "scripts": {
    "dev": "tsx watch src/main.ts",
    "build": "tsc -p tsconfig.build.json",
    "start": "node dist/main.js",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "lint": "eslint src --ext .ts",
    "test": "vitest run",
    "migrate": "tsx src/db/migrate-cli.ts"
  },
  "dependencies": {
    "@ai-km/service-conversation": "workspace:*",
    "@ai-km/service-feedback": "workspace:*",
    "@ai-km/service-generation": "workspace:*",
    "@ai-km/service-identity": "workspace:*",
    "@ai-km/service-ingestion": "workspace:*",
    "@ai-km/service-model-gateway": "workspace:*",
    "@ai-km/service-retrieval": "workspace:*",
    "@apidevtools/json-schema-ref-parser": "^11.7.2",
    "@fastify/cookie": "^11.0.2",
    "@fastify/cors": "^10.0.2",
    "@fastify/helmet": "^13.0.1",
    "@fastify/multipart": "^9.0.3",
    "ajv": "^8.17.1",
    "ajv-formats": "^3.0.1",
    "better-sqlite3": "^11.8.1",
    "fastify": "^5.2.1",
    "fastify-plugin": "^5.0.1",
    "js-yaml": "^4.1.0"
  },
  "devDependencies": {
    "@types/better-sqlite3": "^7.6.12",
    "@types/js-yaml": "^4.0.9",
    "@types/node": "^22.10.0",
    "tsx": "^4.19.2",
    "typescript": "^5.7.0",
    "vitest": "^2.1.0"
  }
}
