# No real secrets here — scaffold placeholder only.
# NEXT_PUBLIC_API_BASE_URL=

# E03-S035. "api" (default, unset) talks to the real /auth/* endpoints via
# @ai-km/api-client; "mock" uses the in-memory mock (no backend needed).
# NEXT_PUBLIC_AUTH_BACKEND=

# E03-S035. Server-side only (no NEXT_PUBLIC_ prefix — never sent to the
# browser): where apps/web's /api/v1/:path* rewrite proxies to. Defaults to
# http://127.0.0.1:4000 (apps/api's dev port) when unset.
# API_INTERNAL_URL=

# E03-S041. Push-to-talk voice input in the message composer. Defaults to
# enabled; set to "false" to turn it off (e.g. a deployment with no ASR
# sidecar configured).
# NEXT_PUBLIC_FEATURE_VOICE_INPUT=

# E03-S046. Conversations list page size. Integer 1-200 (the server's own
# pageSize cap); an invalid or out-of-range value falls back to the
# default and logs a warning rather than failing. See
# docs/runbooks/config.md for details.
# NEXT_PUBLIC_CONVERSATIONS_PAGE_SIZE=20

# E03-S045. Gates every "[模擬:X]" demo/test hook (fake answer states,
# stream disconnect, file-processing failure). Defaults to disabled in
# production — a real user must never be able to fake a PERMISSION_DENIED
# or SOURCE_UNAVAILABLE answer just by typing a bracketed string. Set to
# "true" only for demos or E2E. See docs/runbooks/mock-triggers.md for
# the full trigger list.
# NEXT_PUBLIC_FEATURE_MOCK_TRIGGERS=false
