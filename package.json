{
  "name": "ai-km",
  "private": true,
  "packageManager": "pnpm@11.9.0",
  "engines": {
    "node": ">=22 <23"
  },
  "scripts": {
    "build": "turbo run build",
    "dev": "turbo run dev --parallel",
    "lint": "turbo run lint",
    "typecheck": "turbo run typecheck",
    "contract-gate": "node contracts/openapi/__checks__/run-gate.mjs",
    "test": "turbo run test",
    "test:e2e": "turbo run test --filter=@ai-km/e2e",
    "format": "prettier --write .",
    "demo:w1-00": "pnpm --filter @ai-km/tool-asr-readiness exec tsx ../w1-00-demo/run.ts",
    "accept": "pnpm --filter @ai-km/features accept",
    "accept:phase1": "pnpm --filter @ai-km/features accept:phase1",
    "accept:integration": "pnpm --filter @ai-km/features accept:integration",
    "gherkin:dup": "pnpm --filter @ai-km/features gherkin:dup",
    "docs:links": "pnpm --filter @ai-km/features docs:links"
  },
  "devDependencies": {
    "turbo": "^2.3.0",
    "typescript": "^5.7.0",
    "prettier": "^3.4.0",
    "eslint": "^8.57.0",
    "@typescript-eslint/eslint-plugin": "^7.18.0",
    "@typescript-eslint/parser": "^7.18.0",
    "eslint-config-prettier": "^9.1.0"
  }
}
